{
  "name": "FleetConfig",
  "type": "object",
  "properties": {
    "ownerEmail": {
      "type": "string",
      "title": "Owner Account Email (landscaper tenant)"
    },
    "pricePerThousandSqFt": {
      "type": "number",
      "title": "Price per 1,000 sq ft ($)"
    },
    "hourlyLaborRatePerWorker": {
      "type": "number",
      "title": "Hourly Labor Rate ($/worker)"
    },
    "crewSizeCount": {
      "type": "integer",
      "title": "Crew Size (workers)"
    },
    "baseMowSpeedSqFtPerHour": {
      "type": "number",
      "title": "Base Mow Speed (sq ft/hr)"
    },
    "truckAverageMpg": {
      "type": "number",
      "title": "Truck Average MPG"
    },
    "currentFuelPricePerGallon": {
      "type": "number",
      "title": "Current Fuel Price ($/gal)"
    },
    "vehicleWearRatePerMile": {
      "type": "number",
      "title": "Vehicle Wear Rate ($/mile)"
    },
    "minimumTripFee": {
      "type": "number",
      "title": "Minimum Trip Fee ($)"
    },
    "flatConvenienceFee": {
      "type": "number",
      "title": "Flat Convenience Fee ($)"
    },
    "targetGrossMargin": {
      "type": "number",
      "title": "Target Gross Margin (0\u20131)"
    },
    "maxDensityRadiusMiles": {
      "type": "number",
      "title": "Max Density Radius (mi)"
    },
    "depotAddress": {
      "type": "string",
      "title": "Depot / Nearest Route Origin Address"
    }
  },
  "required": [
    "ownerEmail",
    "pricePerThousandSqFt",
    "hourlyLaborRatePerWorker",
    "crewSizeCount",
    "baseMowSpeedSqFtPerHour",
    "truckAverageMpg",
    "currentFuelPricePerGallon",
    "vehicleWearRatePerMile",
    "minimumTripFee",
    "flatConvenienceFee",
    "targetGrossMargin",
    "maxDensityRadiusMiles",
    "depotAddress"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        { "data.ownerEmail": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "data.ownerEmail": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}